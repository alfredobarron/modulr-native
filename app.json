{
  "expo": {
    "name": "Modulr",
    "slug": "modulr-native",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "modulr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
